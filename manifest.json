{
  "manifest_version": 3,
  "name": "AI Text Tools",
  "description": "Быстрые AI-запросы по выделению, странице и изображениям с потоковым ответом.",
  "version": "6.9.0",
  "permissions": ["contextMenus", "storage", "unlimitedStorage", "activeTab", "scripting", "sidePanel", "tabs", "alarms"],
  "host_permissions": ["<all_urls>"],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; img-src 'self' data: blob:"
  },
  "background": {
    "service_worker": "background.js"
  },
  "options_page": "options.html",
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "AI Text Tools",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "commands": {
    "ask-ai": {
      "suggested_key": { "default": "Ctrl+Space", "mac": "Command+Shift+Space" },
      "description": "Задать вопрос AI"
    },
    "ask-page": {
      "suggested_key": { "default": "Alt+Shift+A" },
      "description": "Задать вопрос по открытой странице"
    },
    "summarize-page": {
      "suggested_key": { "default": "Alt+Shift+S" },
      "description": "Суммаризировать открытую страницу"
    }
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  }
}
